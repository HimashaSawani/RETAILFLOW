<UserControl x:Class="RetailFlow.Views.TransactionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RetailFlow.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="TRANSACTION HISTORY"
                   Style="{StaticResource HeaderStyle}"
                   Margin="0,0,0,20"/>

        <!-- Search / Filter -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource SearchTextBoxStyle}"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding DateFilters}"
                      SelectedItem="{Binding SelectedDateFilter}"
                      Height="40"
                      FontSize="14"
                      VerticalContentAlignment="Center"
                      ToolTip="Filter by Date"/>
        </Grid>

        <!-- Workspace: Transaction List (Left) + Detail Panel (Right) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Transactions Table -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasNoTransactions, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="📜" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No transactions found." FontSize="16" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center"/>
                        <TextBlock Text="Completed sales will appear here." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Transactions}"
                              SelectedItem="{Binding SelectedTransaction, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF2F7"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeight="44"
                              FontSize="14">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0E7FF"/>
                                        <Setter Property="Foreground" Value="#1E1B4B"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Invoice # -->
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding TransactionNumber}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0F766E"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Date / Time -->
                            <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding FormattedDate}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Items Count -->
                            <DataGridTextColumn Header="Items" Binding="{Binding TotalItems}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Total -->
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding Total, StringFormat='Rs. {0:N2}'}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#15803D"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detailed Breakdown Drawer (Right) -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Visibility="{Binding HasSelectedTransaction, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding SelectedTransaction.TransactionNumber, StringFormat='Transaction: {0}'}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <!-- Date & Time -->
                    <StackPanel Grid.Row="1" Margin="0,6,0,12">
                        <TextBlock Text="Date:" FontSize="12" Foreground="#94A3B8"/>
                        <TextBlock Text="{Binding SelectedTransaction.FormattedFullDate}" FontSize="14" Foreground="#475569" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Border Grid.Row="2" Height="1" Background="#E2E8F0" Margin="0,0,0,14"/>

                    <!-- Scrollable Receipt Details -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Items Breakdown Title -->
                            <TextBlock Text="Items Breakdown:" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,10"/>

                            <!-- Items List -->
                            <ItemsControl ItemsSource="{Binding SelectedTransaction.SaleItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                                                    <TextBlock Foreground="#64748B" FontSize="12">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} × {1:N0} = {2:N0}">
                                                                <Binding Path="Quantity"/>
                                                                <Binding Path="UnitPrice"/>
                                                                <Binding Path="Subtotal"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='Rs. {0:N0}'}" FontWeight="Bold" FontSize="14" Foreground="#0F766E" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Financial Summary -->
                            <Grid Margin="0,14,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:" FontSize="14" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.Subtotal, StringFormat='Rs. {0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Discount:" FontSize="14" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.Discount, StringFormat='- Rs. {0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626"/>
                            </Grid>

                            <Border Height="1" Background="#CBD5E1" Margin="0,2,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL:" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.Total, StringFormat='Rs. {0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#15803D"/>
                            </Grid>

                            <!-- Payment Details -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Payment Method:" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.PaymentMethod}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Amount Tendered:" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.AmountTendered, StringFormat='Rs. {0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E"/>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Change Given:" FontSize="13" FontWeight="Bold" Foreground="#15803D"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.ChangeDue, StringFormat='Rs. {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
