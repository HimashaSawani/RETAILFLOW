<Window x:Class="RetailFlow.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetailFlow - User Authentication &amp; Lock"
        Height="540" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PinBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="QuickUserBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Margin" Value="4"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand / Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Background="#2563EB" CornerRadius="12" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="🔒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="SWITCH USER / AUTHENTICATE" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="Enter 4-Digit Security PIN or Select User" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- PIN Display Input -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="20,0,20,12">
            <PasswordBox x:Name="PinBox"
                         PasswordChar="●"
                         FontSize="26"
                         FontWeight="Bold"
                         Foreground="#38BDF8"
                         Background="Transparent"
                         BorderThickness="0"
                         HorizontalContentAlignment="Center"
                         PasswordChanged="PinBox_PasswordChanged"
                         KeyDown="PinBox_KeyDown"/>
        </Border>

        <!-- Error Message -->
        <TextBlock x:Name="ErrorText" Grid.Row="2"
                   Text=""
                   Foreground="#EF4444"
                   FontWeight="SemiBold"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- PIN Number Pad -->
        <Grid Grid.Row="3" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: 1, 2, 3 -->
            <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>

            <!-- Row 1: 4, 5, 6 -->
            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>

            <!-- Row 2: 7, 8, 9 -->
            <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>

            <!-- Row 3: Clear, 0, Enter -->
            <Button Grid.Row="3" Grid.Column="0" Content="C" Background="#7F1D1D" Foreground="#FCA5A5" Style="{StaticResource PinBtnStyle}" Click="PinClear_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource PinBtnStyle}" Click="PinDigit_Click"/>
            <Button Grid.Row="3" Grid.Column="2" Content="✔" Background="#065F46" Foreground="#6EE7B7" Style="{StaticResource PinBtnStyle}" Click="PinSubmit_Click"/>
        </Grid>

        <!-- Quick 1-Click Role Switcher Presets -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <TextBlock Text="QUICK PRESET LOGIN:" FontSize="11" FontWeight="Bold" Foreground="#64748B" Margin="4,0,0,6"/>
            <UniformGrid Columns="2">
                <Button Content="👤 Store Manager (1234)" Style="{StaticResource QuickUserBtn}" Click="QuickManager_Click"/>
                <Button Content="🛒 Cashier (0000)" Style="{StaticResource QuickUserBtn}" Click="QuickCashier_Click"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
