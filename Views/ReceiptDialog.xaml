<Window x:Class="RetailFlow.Views.ReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RetailFlow.ViewModels"
        mc:Ignorable="d"
        Title="Sale Completed - Receipt"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrintCloseBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / Success Banner -->
        <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="✔ SALE COMPLETED" FontSize="15" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock Text="{Binding InvoiceNumber, StringFormat='Sale #{0}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SaleDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Receipt Content -->
        <Border x:Name="ReceiptPrintArea" Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Items Section Title -->
                    <TextBlock Text="Items Breakdown" FontSize="13" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,10"/>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Product Name & Line Total -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="#0F766E"/>

                                        <!-- Quantity x Price & Stock reduction indicator -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding Quantity}" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock Text=" × Rs. " Foreground="#64748B" FontSize="12"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2}'}" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock Text="  |  Stock: " Foreground="#94A3B8" FontSize="11" Margin="8,0,0,0"/>
                                            <TextBlock Text="{Binding PreviousStock}" Foreground="#DC2626" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text=" ➔ " Foreground="#64748B" FontSize="11"/>
                                            <TextBlock Text="{Binding NewStock}" Foreground="#16A34A" FontWeight="SemiBold" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Financial & Payment Summary -->
                    <StackPanel Margin="0,16,0,0">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal:" FontSize="14" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='Rs. {0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Discount:" FontSize="14" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding Discount, StringFormat='- Rs. {0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626"/>
                        </Grid>

                        <Border Height="1" Background="#E2E8F0" Margin="0,4,0,6"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL:" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat='Rs. {0:N2}'}" FontSize="20" FontWeight="Bold" Foreground="#15803D"/>
                        </Grid>

                        <Border Height="1" Background="#CBD5E1" Margin="0,2,0,8"/>

                        <!-- Payment Details -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Payment Method:" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding PaymentMethod}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Amount Tendered / Paid:" FontSize="13" Foreground="#64748B"/>
                            <TextBlock Grid.Column="1" Text="{Binding AmountTendered, StringFormat='Rs. {0:N2}'}" FontSize="13" FontWeight="SemiBold" Foreground="#0F766E"/>
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Change Given:" FontSize="13" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock Grid.Column="1" Text="{Binding ChangeDue, StringFormat='Rs. {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#15803D"/>
                        </Grid>

                        <!-- Customer Loyalty Summary -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="⭐ Customer Loyalty Rewards" FontWeight="Bold" FontSize="12" Foreground="#2563EB" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CustomerName, StringFormat='Customer: {0}'}" FontSize="12" Foreground="#334155"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Points Redeemed:" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LoyaltyPointsRedeemed, StringFormat='-{0} pts'}" FontSize="11" FontWeight="SemiBold" Foreground="#DC2626"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Points Earned (This Order):" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LoyaltyPointsEarned, StringFormat='+{0} pts'}" FontSize="11" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Updated Points Balance:" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CustomerPointsBalance, StringFormat='{}{0} pts'}" FontSize="12" FontWeight="Bold" Foreground="#2563EB"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Three Print & Export Options -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="🖨️ ESC/POS Thermal"
                        Height="40"
                        Background="#1E293B"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="11"
                        Cursor="Hand"
                        BorderThickness="0"
                        ToolTip="Direct thermal receipt printing / simulator"
                        Command="{Binding PrintEscPosCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="2"
                        Content="🖨️ System / PDF Print"
                        Height="40"
                        Background="#0F766E"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="11"
                        Cursor="Hand"
                        BorderThickness="0"
                        ToolTip="Print via Windows Print Dialog (Microsoft Print to PDF or physical printer)"
                        Command="{Binding PrintCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="4"
                        Content="📄 Open Digital / PDF"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="11"
                        Cursor="Hand"
                        BorderThickness="0"
                        ToolTip="Generate formatted vector HTML/PDF receipt and open in browser"
                        Command="{Binding ExportHtmlCommand}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Row 2: Done / Close Button -->
            <Button Grid.Row="2"
                    Content="Done / New Sale [Enter]"
                    Style="{StaticResource PrintCloseBtnStyle}"
                    Height="38"
                    FontSize="13"
                    Background="#334155"
                    Command="{Binding CloseCommand}"
                    IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
