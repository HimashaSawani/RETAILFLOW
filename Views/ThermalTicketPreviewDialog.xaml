<Window x:Class="RetailFlow.Views.ThermalTicketPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ESC/POS Thermal Receipt Simulator"
        Height="650" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Thermal Paper Ticket -->
            <RowDefinition Height="*"/>
            <!-- Bottom Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Status -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🖨️ ESC/POS Thermal Receipt" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="80mm Continuous Thermal Paper Output" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#14532D" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="● SPOOLER OK" FontWeight="Bold" FontSize="11" Foreground="#4ADE80"/>
            </Border>
        </Grid>

        <!-- Realistic Thermal Paper Receipt Card -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="16" Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <ScrollViewer x:Name="TicketScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Paper Top Jagged Notch Visual -->
                    <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                        <TextBlock Text="· · · ✂ · · · 80mm THERMAL RECEIPT · · · ✂ · · ·"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Exact Monospaced Ticket Content -->
                    <TextBlock x:Name="TicketContentText"
                               FontFamily="Consolas, 'Courier New', monospace"
                               FontSize="12.5"
                               LineHeight="18"
                               Foreground="#0F172A"
                               TextWrapping="NoWrap"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="PrinterStatusText"
                       Text="Printed to Virtual ESC/POS Simulator."
                       Foreground="#94A3B8"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="Done / Close"
                    Width="110"
                    Height="36"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="12"
                    Cursor="Hand"
                    BorderThickness="0"
                    Click="Close_Click"
                    IsDefault="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
