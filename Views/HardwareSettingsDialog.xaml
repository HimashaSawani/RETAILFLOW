<Window x:Class="RetailFlow.Views.HardwareSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware Integration &amp; Peripherals" 
        Height="540" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="⚙️ HARDWARE &amp; PERIPHERALS INTEGRATION" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Configure ESC/POS thermal receipt printers, cash drawers, and barcode scanners." FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Thermal Printer Integration -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🖨️ Thermal ESC/POS Receipt Printer" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                <TextBlock Text="Direct raw ESC/POS command stream via Windows WinSpool" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="12" Padding="10,4">
                                <TextBlock Text="● Ready" Foreground="#16A34A" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Active Printer Device:" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,6,0,6"/>
                        <ComboBox x:Name="PrintersComboBox" Height="38" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Test Print ESC/POS" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="TestPrint_Click"/>
                            <Button Content="Kick Cash Drawer" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="KickDrawer_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Barcode Scanner Integration -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="📷 Barcode Scanner (USB / HID Keyboard Wedge)" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                <TextBlock Text="Automatic rapid keystroke capture (&lt; 50ms) + Audio feedback" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#E0F2FE" CornerRadius="12" Padding="10,4">
                                <TextBlock Text="● Active Hook" Foreground="#0284C7" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Scanner Test Pad (Scan any item barcode here):" FontWeight="SemiBold" FontSize="13" Foreground="#334155" Margin="0,6,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ScannerTestBox" Grid.Column="0" Height="36" FontSize="13" Padding="10,0" VerticalContentAlignment="Center" KeyDown="ScannerTestBox_KeyDown"/>
                            <Button Grid.Column="1" Content="🔊 Test Beep" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="TestBeep_Click"/>
                        </Grid>
                        <TextBlock x:Name="ScanResultText" Text="Scan or type barcode and press Enter" Foreground="#64748B" FontSize="12" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Status Output Box -->
                <TextBlock x:Name="StatusOutputText" Text="" Foreground="#2563EB" FontWeight="SemiBold" FontSize="12" Margin="4,0,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="Save &amp; Close" Height="42" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="14" BorderThickness="0" Cursor="Hand" Click="Close_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
