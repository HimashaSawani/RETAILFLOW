<UserControl x:Class="RetailFlow.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:RetailFlow.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="950"
             FontFamily="Segoe UI"
             Background="#F8FAFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style x:Key="CompleteSaleBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="NEW SALE (POS)"
                   Style="{StaticResource HeaderStyle}"
                   Margin="0,0,0,16"/>

        <!-- Messages / Alerts -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <!-- Insufficient Stock / Validation Error Alert -->
            <Border Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠ " Foreground="#DC2626" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#B91C1C"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Success Alert -->
            <Border Background="#F0FDF4"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔ " Foreground="#16A34A" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#15803D"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main POS Workspace: Product Selection + Cart + Totals -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Product Selection Form -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Product Selection" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,16"/>

                    <!-- Product Dropdown -->
                    <TextBlock Text="Product:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AvailableProducts}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              Height="40"
                              FontSize="14"
                              Margin="0,0,0,16">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="290">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding SKU, StringFormat='SKU: {0}'}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N2}'}" FontWeight="Bold" Foreground="#0F766E" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding StockQuantity, StringFormat='Stock: {0}'}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Selected Product Details Preview -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Unit Price:" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedProduct.SellingPrice, StringFormat='{}{0:N2}', TargetNullValue='--'}" FontWeight="Bold" Foreground="#0F766E"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Available Stock:" FontSize="13" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedProduct.StockQuantity, TargetNullValue='--'}" FontWeight="Bold" Foreground="#1E293B"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Quantity Input -->
                    <TextBlock Text="Quantity:" FontWeight="SemiBold" FontSize="13" Foreground="#475569" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             FontSize="16"
                             FontWeight="Bold"
                             Padding="10,6"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,20"/>

                    <!-- Add To Cart Button -->
                    <Button Content="🛒 Add to Cart"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Command="{Binding AddToCartCommand}"/>
                </StackPanel>
            </Border>

            <!-- Right Panel: Cart & Checkout Summary -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Table -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cart Title -->
                        <Border Grid.Row="0" Background="#F1F5F9" Padding="16,12" CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cart" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                <Button Grid.Column="1"
                                        Content="Remove Item"
                                        FontSize="12"
                                        Background="#FEE2E2"
                                        Foreground="#DC2626"
                                        BorderThickness="0"
                                        Padding="10,4"
                                        Cursor="Hand"
                                        Command="{Binding RemoveFromCartCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Cart DataGrid -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding CartItems}"
                                  SelectedItem="{Binding SelectedCartItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  RowHeight="42"
                                  FontSize="14">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Height" Value="36"/>
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat={}{0:N2}}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#0F766E"/>
                                            <Setter Property="Padding" Value="12,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Order Summary & Checkout -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <!-- Totals Breakdown -->
                        <StackPanel Grid.Column="0">
                            <!-- Subtotal -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Subtotal:" FontSize="15" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat={}{0:N2}}" FontSize="15" FontWeight="SemiBold" Foreground="#1E293B"/>
                            </Grid>

                            <!-- Discount Input -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Discount:" FontSize="15" Foreground="#64748B" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                                         Height="32"
                                         FontSize="14"
                                         TextAlignment="Right"
                                         Padding="6,2"/>
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1" Background="#CBD5E1" Margin="0,4,0,10"/>

                            <!-- Total -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL:" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="#15803D"/>
                            </Grid>
                        </StackPanel>

                        <!-- Complete Sale Button -->
                        <Button Grid.Column="2"
                                Content="COMPLETE SALE"
                                Style="{StaticResource CompleteSaleBtnStyle}"
                                Command="{Binding CompleteSaleCommand}"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
