<Window x:Class="RetailFlow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RetailFlow.Views"
        xmlns:vm="clr-namespace:RetailFlow.ViewModels"
        mc:Ignorable="d"
        Title="RetailFlow - Retail Management System" 
        Height="720" Width="1100"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- DataTemplates for Module Views -->
        <DataTemplate DataType="{x:Type vm:ProductManagementViewModel}">
            <views:ProductManagementView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:StockManagementViewModel}">
            <views:StockManagementView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>

        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Bar / Header -->
            <RowDefinition Height="64"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation / Brand Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="RF" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="RetailFlow" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📦 Products"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowProductsCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="📊 Stock Management"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowStockCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="🛒 Point of Sale (POS)"
                            Style="{StaticResource NavButtonStyle}"
                            Command="{Binding ShowPosCommand}"/>
                </StackPanel>

                <!-- Active Module Indicator -->
                <Border Grid.Column="3" Background="#1E293B" CornerRadius="6" Padding="14,6">
                    <TextBlock Text="{Binding ActiveModuleName, StringFormat='Active: {0}'}" 
                               Foreground="#38BDF8" 
                               FontWeight="SemiBold" 
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- Dynamic Module Content -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
